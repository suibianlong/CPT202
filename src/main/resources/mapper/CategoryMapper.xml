<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cpt202.module3.mapper.CategoryMapper">

    <resultMap id="CategoryResultMap" type="com.cpt202.module3.entity.Category">
        <id column="category_id" property="categoryId"/>
        <result column="category_type" property="categoryType"/>
        <result column="category_topic" property="categoryTopic"/>
        <result column="status" property="status"/>
        <result column="usage_count" property="usageCount"/>
        <result column="created_time" property="createdTime"/>
        <result column="last_updated_time" property="lastUpdatedTime"/>
    </resultMap>

    <select id="selectActiveCategories" resultMap="CategoryResultMap">
        SELECT
            category_id,
            category_type,
            category_topic,
            status,
            usage_count,
            created_time,
            last_updated_time
        FROM category
        WHERE status = 'ACTIVE'
        ORDER BY usage_count DESC, category_topic ASC
    </select>

</mapper>
<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cpt202.module3.mapper.TagMapper">

    <resultMap id="TagResultMap" type="com.cpt202.module3.entity.Tag">
        <id column="tag_id" property="tagId"/>
        <result column="tag_name" property="tagName"/>
        <result column="status" property="status"/>
        <result column="usage_count" property="usageCount"/>
        <result column="created_time" property="createdTime"/>
        <result column="last_updated_time" property="lastUpdatedTime"/>
    </resultMap>

    <select id="selectActiveTags" resultMap="TagResultMap">
        SELECT
            tag_id,
            tag_name,
            status,
            usage_count,
            created_time,
            last_updated_time
        FROM tag
        WHERE status = 'ACTIVE'
        ORDER BY usage_count DESC, tag_name ASC
    </select>

</mapper>